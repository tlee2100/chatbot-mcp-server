{
  "mcpServers": {
    "chatbot-mcp-server": {
      "command": "npm",
      "args": [
        "--prefix",
        "<YOUR_ABSOLUTE_PATH_TO_PROJECT>/chatbot-mcp-server",
        "run",
        "start:stdio"
      ],
      "env": {
        "SITE_ID": "1",
        "CONVERSATION_ID": "your-test-conversation-uuid-here"
      }
    }
  }
}
